{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agy_opportunity_reminder.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\agy_opportunity_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Initializing Polyphony routing mode"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agy_opportunity_reminder.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\agy_opportunity_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Evaluating Agy routing mode"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agy_opportunity_reminder.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\agy_opportunity_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Checking Agy routing enforcement"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agy_opportunity_reminder.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\agy_opportunity_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Recording Agy execution result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agy_opportunity_reminder.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\agy_opportunity_reminder.py\"",
            "timeout": 10,
            "statusMessage": "Verifying Agy routing gate"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/agy_opportunity_reminder.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}\\hooks\\agy_opportunity_reminder.py\"",
            "timeout": 3,
            "statusMessage": "Cleaning up Polyphony routing state"
          }
        ]
      }
    ]
  }
}
